{
  "manifest_version": 3,
  "name": "Freebyrd browser bridge",
  "description": "Sends the text of the page you are viewing to the Freebyrd desktop app on this Mac.",
  "version": "0.1.0",
  "key": "",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "tabs", "storage", "scripting", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Freebyrd",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "default_popup": "popup.html"
  }
}
